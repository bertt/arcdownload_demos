,[133.8,15.9],[133.1,19],[130.8,21.9],[127.2,24.7],[122.4,27.1],[116.5,29],[109.8,30.5],[102.5,31.4],[94.9,31.7],[87.3,31.4],[80,30.5],[73.2,29],[67.3,27.1],[62.5,24.7],[58.9,21.9],[56.6,19],[55.9,15.9],[56.6,12.8],[58.9,9.8],[62.5,7.1],[67.3,4.7],[73.2,2.7],[80,1.2],[87.3,0.3],[94.9,0]]]},"symbol":{"type":"CIMPolygonSymbol","symbolLayers":[{"type":"CIMSolidFill","enable":true,"color":[17,26,40,255]}]}},{"type":"CIMMarkerGraphic","geometry":{"rings":[[[94.9,41.9],[96.2,42],[97.4,42.4],[98.5,42.9],[99.5,43.7],[100.4,44.6],[101.2,45.6],[101.7,46.7],[102.1,47.9],[102.2,49.2],[102.2,296.4],[100.1,301.6],[94.9,303.7],[94.2,303.7],[93,303.5],[91.9,303.1],[90.9,302.5],[89.9,301.7],[89.1,300.8],[88.5,299.8],[88,298.7],[87.7,297.6],[87.6,296.4],[87.6,49.2],[89.7,44],[94.9,41.9]]]},"symbol":{"type":"CIMPolygonSymbol","symbolLayers":[{"type":"CIMSolidFill","enable":true,"color":[17,26,40,255]}]}}],"scaleSymbolsProportionally":true,"respectFrame":true,"clippingPath":{"type":"CIMClippingPath","clippingType":"Intersect","path":{"rings":[[[0,0],[190,0],[190,336],[0,336],[0,0]]]}},"rotation":0}],"haloSize":1,"scaleX":1,"angleAlignment":"Display","angle":0}},"popupInfo":{"popupElements":[{"type":"text","text":"<p><span style='font-size:16.0pt;'>Stappen voor het berekenen van Panden percentage per buurt in QGIS:&nbsp;<\/span><\/p><p>&nbsp;<\/p><p>Om het percentage te berekenen voor panden in de buurten van de gemeente doe je het als volgt:<\/p><p><strong>Stap 1:&nbsp;<\/strong><\/p><p>De gegevens verzamelen ( GIS_panden shapefile en buurtgerenzen shapefile ) en controleren de data.&nbsp;<\/p><p><strong>Stap 2:&nbsp;<\/strong><\/p><p>Laad deze shapefiles in QGIS en visualiseer de gegevens in een de kaart.&nbsp;<\/p><p><strong>Stap 3:&nbsp;<\/strong><\/p><p>De oppervlakte in m2 voor buurten bereken met expressie : $area, en sla deze laag op. En geef hem een naam, bvb, \u201cOppervlakte (m2)\u201d.&nbsp;<span>&nbsp;<\/span><\/p><p><strong>Stap 4:&nbsp;<\/strong><\/p><p>Nu gaan we de geometries van Panden toevoegen aan de buurten dit doe je als volgt: <strong>Vector --&gt; Datamanagement gereedschap --&gt; Koppel attributen op basis van plaats. Invoerlaag:&nbsp;<\/strong>Panden, <strong>vergelijken met:&nbsp;<\/strong><span>&nbsp;<\/span>Buurten laag, <strong>Velden toevoegen:&nbsp;<\/strong>Buurt_naam, Oppervlakte. Sla deze op en geef het een naam bvb,\u201dpanden met buurten\u201d<\/p><p><strong>Stap 5:&nbsp;<\/strong><\/p><p>Samenvoegen van gekoppelde laag: <strong>Invoerlaag<\/strong>:&nbsp;<span> <\/span>De gekoppelde \u201cpanden met buurten\u201d laag, <strong>Velden toegvoegen<\/strong>: \u201cBuurtnaam\u201d en sla deze op en geef hier een naam bvb, \u201csamengevoegd panden met buurten\u201d. Als het goed is heb jij nu een laag waarin kun een classificatie uitvoeren op basis van \u201cBuurtnaam\u201d.<\/p><p><strong>Stap 6:&nbsp;<\/strong><\/p><p><span>&nbsp;<\/span>Nu gaan we de oppervlakte van de geometrie van alle panden berekenen in m2: gebruik ook $area expressie en geef de nieuwe kolom een naam, bvb, \u201cPanden area(m2)\u201d en uitvoeren.&nbsp;<\/p><p><strong>Stap 7:&nbsp;<\/strong><\/p><p>Percentage berekenen van panden per buurt: doe je het ook via een nieuwe kolom aanmaken en geef het een naam, bvb, \u201cPanden percentage\u201d. Gebruik deze expressie:&nbsp;<\/p><figure><table style='border-collapse:collapse;' cellpadding='0' cellspacing='0' border='1'><tbody><tr><td style='border:1.0pt solid windowtext; padding:0cm 5.4pt; width:247.85pt;' width='330'><span style='color:#2F5496;'>(\u201cPanden area(m2)\u201d / \u201cOppervlakte (m2)\u201d) * 100<\/span><\/td><\/tr><\/tbody><\/table><\/figure><p><strong>Stap 8:&nbsp;<\/strong><span>&nbsp;<\/span><\/p><p>Koppel de Percentage kolom aan de buurten laag: rechte knopmuis op Buurten laag en kies <strong>Eigenschappen<\/strong>--&gt; <strong>koppelingen<\/strong> --&gt; <strong>nieuwe koppeling<\/strong> (+ drukken) --&gt; <strong>Invoerlaag<\/strong>--&gt; \u201cpanden percentage laag\u201d --&gt; <strong>koppelvelden<\/strong> --&gt; \u201cbuurt_naam\u201d --&gt; <strong>gekoppeldeveld<\/strong> --&gt; \u201cPanden percentage kolom\u201d en dan <strong>toepassen<\/strong>.&nbsp;<\/p><p><strong>Stap 9:&nbsp;<\/strong><\/p><p>Classificeren en analyseren van het resultaten voor \u201cBuurtgrenzen laag\u201d op basis van het percentage en ploten als \u201cPar Plot\u201d. Gebruik de \u201cDataplotly\u201d plug-in en voer bij x field: Buurtnaam en bij y field: Panden percentage kolom.&nbsp;<\/p>"}],"description":"<p><span style='font-size:16.0pt;'>Stappen voor het berekenen van Panden percentage per buurt in QGIS:&nbsp;<\/span><\/p><p>&nbsp;<\/p><p>Om het percentage te berekenen voor panden in de buurten van de gemeente doe je het als volgt:<\/p><p><strong>Stap 1:&nbsp;<\/strong><\/p><p>De gegevens verzamelen ( GIS_panden shapefile en buurtgerenzen shapefile ) en controleren de data.&nbsp;<\/p><p><strong>Stap 2:&nbsp;<\/strong><\/p><p>Laad deze shapefiles in QGIS en visualiseer de gegevens in een de kaart.&nbsp;<\/p><p><strong>Stap 3:&nbsp;<\/strong><\/p><p>De oppervlakte in m2 voor buurten bereken met expressie : $area, en sla deze laag op. En geef hem een naam, bvb, \u201cOppervlakte (m2)\u201d.&nbsp;<span>&nbsp;<\/span><\/p><p><strong>Stap 4:&nbsp;<\/strong><\/p><p>Nu gaan we de geometries van Panden toevoegen aan de buurten dit doe je als volgt: <strong>Vector --&gt; Datamanagement gereedschap --&gt; Koppel attributen op basis van plaats. Invoerlaag:&nbsp;<\/strong>Panden, <strong>vergelijken met:&nbsp;<\/strong><span>&nbsp;<\/span>Buurten laag, <strong>Velden toevoegen:&nbsp;<\/strong>Buurt_naam, Oppervlakte. Sla deze op en geef het een naam bvb,\u201dpanden met buurten\u201d<\/p><p><strong>Stap 5:&nbsp;<\/strong><\/p><p>Samenvoegen van gekoppelde laag: <strong>Invoerlaag<\/strong>:&nbsp;<span> <\/span>De gekoppelde \u201cpanden met buurten\u201d laag, <strong>Velden toegvoegen<\/strong>: \u201cBuurtnaam\u201d en sla deze op en geef hier een naam bvb, \u201csamengevoegd panden met buurten\u201d. Als het goed is heb jij nu een laag waarin kun een classificatie uitvoeren op basis van \u201cBuurtnaam\u201d.<\/p><p><strong>Stap 6:&nbsp;<\/strong><\/p><p><span>&nbsp;<\/span>Nu gaan we de oppervlakte van de geometrie van alle panden berekenen in m2: gebruik ook $area expressie en geef de nieuwe kolom een naam, bvb, \u201cPanden area(m2)\u201d en uitvoeren.&nbsp;<\/p><p><strong>Stap 7:&nbsp;<\/strong><\/p><p>Percentage berekenen van panden per buurt: doe je het ook via een nieuwe kolom aanmaken en geef het een naam, bvb, \u201cPanden percentage\u201d. Gebruik deze expressie:&nbsp;<\/p><figure><table style='border-collapse:collapse;' cellpadding='0' cellspacing='0' border='1'><tbody><tr><td style='border:1.0pt solid windowtext; padding:0cm 5.4pt; width:247.85pt;' width='330'><span style='color:#2F5496;'>(\u201cPanden area(m2)\u201d / \u201cOppervlakte (m2)\u201d) * 100<\/span><\/td><\/tr><\/tbody><\/table><\/figure><p><strong>Stap 8:&nbsp;<\/strong><span>&nbsp;<\/span><\/p><p>Koppel de Percentage kolom aan de buurten laag: rechte knopmuis op Buurten laag en kies <strong>Eigenschappen<\/strong>--&gt; <strong>koppelingen<\/strong> --&gt; <strong>nieuwe koppeling<\/strong> (+ drukken) --&gt; <strong>Invoerlaag<\/strong>--&gt; \u201cpanden percentage laag\u201d --&gt; <strong>koppelvelden<\/strong> --&gt; \u201cbuurt_naam\u201d --&gt; <strong>gekoppeldeveld<\/strong> --&gt; \u201cPanden percentage kolom\u201d en dan <strong>toepassen<\/strong>.&nbsp;<\/p><p><strong>Stap 9:&nbsp;<\/strong><\/p><p>Classificeren en analyseren van het resultaten voor \u201cBuurtgrenzen laag\u201d op basis van het percentage en ploten als \u201cPar Plot\u201d. Gebruik de \u201cDataplotly\u201d plug-in en voer bij x field: Buurtnaam en bij y field: Panden percentage kolom.&nbsp;<\/p>","title":""}},{"attributes":{"title":"Stappen handleiding","OBJECTID":2},"geometry":{"spatialReference":{"latestWkid":28992,"wkid":28992},"x":140766.75505633