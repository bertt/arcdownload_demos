{"source":"e4af8e4f8e8247d0bf167e23b4a8f1bc","folderId":"ed6e9801438949f4a49a6588d1c57e12","values":{"fullAppSettings":true,"basemapGalleryConfig":{"basemapIdsToFilter":[]},"searchConfiguration":{"searchAllEnabled":false,"allPlaceholder":"Kelder, adres of plaats zoeken","sources":[{"url":"https://geocoder.arcgisonline.nl/arcgis/rest/services/Geocoder_NL_RD/GeocodeServer","singleLineFieldName":"SingleLine","name":"Esri Nederland Geocoder","placeholder":"Adres of plaats zoeken","maxResults":6,"maxSuggestions":6,"suggestionsEnabled":true,"minSuggestCharacters":1,"withinViewEnabled":false,"countryCode":"","zoomScale":null,"_uid":"ea32beea165"}],"activeSourceIndex":0},"title":"Gemeente Utrecht - Digitale Atlas Energielandschap Rijnenburg en Reijerscop","customHeader":false,"splash":false,"sidebarExpanded":true,"activePanel":"details","layerListPanel":true,"bookmarksPanel":false,"layerEditPanel":false,"detailsContent":"<div style=\"background-color:rgb(255, 255, 255); box-sizing:border-box; color:rgb(0, 0, 0); font-family:&quot;Avenir Light&quot;, Verdana, Geneva, sans-serif; font-size:12px; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; margin:0px; padding:0px; text-align:left; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;\"><b><span style=\"box-sizing:border-box; font-family:Verdana, sans-serif; font-size:10pt;\"><strong>Digitale atlas Energielandschap Rijnenburg en Reijerscop</strong></span></b><br>&nbsp;</div><div style=\"background-color:rgb(255, 255, 255); box-sizing:border-box; color:rgb(0, 0, 0); font-family:&quot;Avenir Light&quot;, Verdana, Geneva, sans-serif; font-size:12px; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; margin:0px; padding:0px; text-align:left; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;\"><span style=\"box-sizing:border-box; font-family:Verdana; font-size:10pt;\">De gemeente Utrecht wil in de polders Rijnenburg en Reijerscop voor minimaal 20 jaar plaats bieden voor een energielandschap met maximaal acht windmolens en ongeveer 230 hectare zonnevelden</span><i><span style=\"box-sizing:border-box; font-family:Verdana; font-size:10pt;\">.</span></i><span style=\"box-sizing:border-box; font-family:Verdana, sans-serif; font-size:10pt;\">&nbsp;Zij wil hiermee een forse bijdrage leveren aan het opwekken van duurzame energie, binnen bepaalde randvoorwaarden zoals het beperken van geluid en slagschaduw.</span><br>&nbsp;</div><div style=\"background-color:rgb(255, 255, 255); box-sizing:border-box; color:rgb(0, 0, 0); font-family:&quot;Avenir Light&quot;, Verdana, Geneva, sans-serif; font-size:12px; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; margin:0px; padding:0px; text-align:left; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;\"><span style=\"box-sizing:border-box; font-family:Verdana, sans-serif; font-size:10pt;\">Op deze website ziet u een kaart met verschillende lagen waarmee de zoekgebieden voor wind- en zonne-energie zijn opgebouwd, zoals de cultuurhistorische ensembles, vrijwaringszones vanwege veiligheid en afstand tot de woonwijken.</span></div><div style=\"background-color:rgb(255, 255, 255); box-sizing:border-box; color:rgb(0, 0, 0); font-family:&quot;Avenir Light&quot;, Verdana, Geneva, sans-serif; font-size:12px; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; margin:0px; padding:0px; text-align:left; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;\">&nbsp;</div><div style=\"background-color:rgb(255, 255, 255); box-sizing:border-box; color:rgb(0, 0, 0); font-family:&quot;Avenir Light&quot;, Verdana, Geneva, sans-serif; font-size:12px; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; margin:0px; padding:0px; text-align:left; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;\"><span style=\"box-sizing:border-box; font-family:Verdana, sans-serif; font-size:10pt;\">Rechts bovenin vindt u twee knoppen, één voor de legenda en de andere voor de kaartlagen. Met de knop voor de kaartlagen, kunt u lagen aan en uit zetten.</span><br>&nbsp;</div><div style=\"background-color:rgb(255, 255, 255); box-sizing:border-box; color:rgb(0, 0, 0); font-family:&quot;Avenir Light&quot;, Verdana, Geneva, sans-serif; font-size:12px; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; margin:0px; padding:0px; text-align:left; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;\"><span style=\"box-sizing:border-box; font-family:Verdana, sans-serif; font-size:10pt;\">Meer informatie over Energielandschap Rijnenburg en Reijerscop vindt u op&nbsp;</span><a style=\"box-sizing:border-box;\" href=\"https://www.utrecht.nl/wonen-en-leven/duurzame-stad/energie/energie-opwekken/windmolens-in-rijnenburg-en-reijerscop/\" target=\"_self\"><span style=\"box-sizing:border-box; font-family:Verdana, sans-serif; font-size:10pt;\">utrecht.nl/rijnenburg</span></a><span style=\"box-sizing:border-box; font-family:Verdana, sans-serif; font-size:10pt;\">.</span></div><div style=\"background-color:rgb(255, 255, 255); box-sizing:border-box; color:rgb(0, 0, 0); font-family:&quot;Avenir Light&quot;, Verdana, Geneva, sans-serif; font-size:12px; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; margin:0px; padding:0px; text-align:left; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;\">&nbsp;</div><div style=\"background-color:rgb(255, 255, 255); box-sizing:border-box; color:rgb(0, 0, 0); font-family:&quot;Avenir Light&quot;, Verdana, Geneva, sans-serif; font-size:12px; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; margin:0px; padding:0px; text-align:left; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;\"><span style=\"box-sizing:border-box; font-family:Verdana, sans-serif; font-size:10pt;\">Aan deze kaart kunnen geen rechten worden ontleend.</span></div>","filterPanel":false,"basemapGallery":false,"enableFeatureSearchScale":false,"popupHover":false,"compassWidget":false,"locateWidget":true,"measure":false,"keyboardShortcuts":true,"disableScroll":false,"scalebarDualMode":false,"extentSelector":false,"enableHighlightColor":true,"enableHighlightHaloColor":true,"basemapToggle":false,"share":false,"customUrlParam":{"layers":[]},"panelSize":"m","theme":"light","customTheme":{"applySharedTheme":false,"applyPresetTheme":true,"font":"Arial","appFont":"Arial","logo":"https://gu-geo.maps.arcgis.com/sharing/rest/content/items/c88735ccb5394943907969a17cce05a8/resources/media/instantAppsConfigPanel_1712215481313_Utrecht_Logo.png","logoLink":"https://www.utrecht.nl/","logoScale":"m","preset":null,"themes":{"primary":{"type":"primary","background":"#FFFFFF","text":"#000000"},"secondary":{"type":"secondary","background":"#FFFFFF","text":"#000000"},"accent":{"type":"accent","background":"#2964A3","text":"#ffffff"}}},"uploads":["https://gu-geo.maps.arcgis.com/sharing/rest/content/items/c88735ccb5394943907969a17cce05a8/resources/media/instantAppsConfigPanel_1712215481313_Utrecht_Logo.png"],"compassWidgetPosition":{"position":"top-left","index":4},"locateWidgetPosition":{"position":"top-left","index":2},"keyboardSho