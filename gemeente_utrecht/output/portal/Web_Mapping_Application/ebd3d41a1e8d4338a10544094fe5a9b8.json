{"source":"e4af8e4f8e8247d0bf167e23b4a8f1bc","folderId":"fda34e01909c4cbaaec0b8822ac7ac70","values":{"fullAppSettings":true,"basemapGalleryConfig":{"basemapIdsToFilter":[]},"searchConfiguration":{"searchAllEnabled":false,"allPlaceholder":"Kelder, adres of plaats zoeken","sources":[{"_uid":"ea32beea165","url":"https://geocoder.arcgisonline.nl/arcgis/rest/services/Geocoder_NL_RD/GeocodeServer","singleLineFieldName":"SingleLine","name":"Esri Nederland Geocoder","placeholder":"Adres of plaats zoeken","maxResults":6,"maxSuggestions":6,"suggestionsEnabled":true,"minSuggestCharacters":1,"withinViewEnabled":false,"countryCode":"","zoomScale":null}],"activeSourceIndex":0},"title":"Programma Gezond Water - Openbaar","customHeader":false,"splash":false,"sidebarExpanded":true,"activePanel":"legendPanel","layerListPanel":true,"bookmarksPanel":false,"layerEditPanel":false,"detailsContent":"<p class=\"MsoNormal\">Gemeente Utrecht en waterschap HDSR voeren tot en met 2028 meer dan 100 maatregelen uit om de waterkwaliteit van sloten, vijvers en grachten in Utrecht te verbeteren. Op deze kaart ziet u met welke maatregelen we in 2025 starten. Zodra er meer informatie over een maatregel bekend is, voegen we die toe aan deze kaart.</p><p class=\"MsoNormal\" style=\"margin-bottom:0cm;\">Ook de waterkwaliteit ziet u op deze kaart. Dit zijn de resultaten van de laatste meting uit 2021. Voor de waterkwaliteit houden we 4 categorieën aan: laag, zichtbaar, levendig en natuurlijk. Ons doel is dat al het water in Utrecht in 2028 minimaal aan het doel 'zichtbaar' voldoet. Op een aantal plekken, zoals in grote delen van Leidsche Rijn en Vleuten - De Meern, is het doel 'levendig'.</p><figure class=\"image\"><img src=\"https://gu-geo.maps.arcgis.com/sharing/rest/content/items/ebd3d41a1e8d4338a10544094fe5a9b8/resources/media/instantAppsConfigPanel_1730108451289_detailsContent_textEditor_1730108450995.png\"></figure><p>De gemeente Utrecht doet haar best om de informatie op deze kaart kloppend en actueel te houden. Komt u iets tegen wat niet klopt of sterk verouderd is, dan vinden wij het fijn als u ons dat laat weten. Dat kan via ons <a href=\"https://www.utrecht.nl/reactieformulier\" target=\"_blank\">reactieformulier</a> of bel 14 030.</p>","filterPanel":false,"basemapGallery":true,"enableFeatureSearchScale":false,"popupHover":false,"compassWidget":false,"locateWidget":true,"measure":false,"keyboardShortcuts":true,"disableScroll":false,"scalebarDualMode":false,"extentSelector":false,"enableHighlightColor":true,"enableHighlightHaloColor":true,"basemapToggle":false,"share":false,"customUrlParam":{"layers":[]},"panelSize":"m","theme":"light","customTheme":{"applySharedTheme":false,"applyPresetTheme":true,"font":"Arial","appFont":"Arial","logo":"https://gu-geo.maps.arcgis.com/sharing/rest/content/items/c88735ccb5394943907969a17cce05a8/resources/media/instantAppsConfigPanel_1712215481313_Utrecht_Logo.png","logoLink":"https://www.utrecht.nl/","logoScale":"m","preset":null,"themes":{"primary":{"type":"primary","background":"#FFFFFF","text":"#000000"},"secondary":{"type":"secondary","background":"#FFFFFF","text":"#000000"},"accent":{"type":"accent","background":"#2964A3","text":"#ffffff"}}},"uploads":["https://gu-geo.maps.arcgis.com/sharing/rest/content/items/ebd3d41a1e8d4338a10544094fe5a9b8/resources/media/instantAppsConfigPanel_1730108451289_detailsContent_textEditor_1730108450995.png"],"compassWidgetPosition":{"position":"top-left","index":4},"locateWidgetPosition":{"position":"top-left","index":5},"keyboardShortcutsPosition":{"position":"top-left","index":2},"screenshotPosition":{"position":"top-left","index":3},"searchPosition":{"position":"top-right","index":0},"splashButtonPosition":{"position":"top-right","index":2},"filterConfig":{"mapId":"f7fec2f4657341a4a6d486f2c767547e","layerExpressions":[]},"datePublished":1738919039417,"expandFilters":true,"selectedLayers":{"layers":[]},"layerListConfig":{"18996a20577-layer-16":{"content":null,"addContent":false,"addTa