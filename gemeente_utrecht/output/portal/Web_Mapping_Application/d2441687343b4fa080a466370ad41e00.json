ears"},"displayAllData":false},"customDateFormat":""},"position":{"relativeTo":"map"}},{"name":"About","version":"2.31","uri":"widgets/About/Widget","config":{"about":{"aboutContent":"<div><span style=\"font-size: 10pt;\">Heeft u vragen over een specifiek initiatief wat\nu ziet op de kaart? Neem dan contact op met de juiste contactpersoon. Zie\nhiervoor het </span><a href=\"https://utrechtcloud.sharepoint.com/:x:/r/sites/ProgrammamanagementBOR/Gedeelde documenten/MJIP-bestand/Overzicht contactpersonen MJIP.xlsx?d=wabd8b6fb5e8d4e17bc55240560322e90&amp;csf=1&amp;web=1&amp;e=eTfHcn\" target=\"_blank\">overzicht contactpersonen MJIP</a><span style=\"font-size: 10pt;\">.</span></div>\n\t<div align=\"center\" style=\"text-align: left;\"><br /></div><div align=\"center\" style=\"text-align: left;\"><br /></div><div align=\"center\" style=\"text-align: left;\">Laatste update: 31 januari 2024</div><div align=\"center\" style=\"text-align: left;\"><br /></div><div align=\"center\" style=\"text-align: left;\">Wijzigingen 31 januari 2024:</div><div align=\"center\" style=\"text-align: left;\"><ul><li>Laag Wegen bijgewerkt (deze was incompleet);</li><li>Laag Civiele Constructies bijgewerkt (in deze laag ontbraken de plan- en eindjaren)</li><li>Lagen toegevoegd als referentie:</li><ul><li>Archeologische waardenkaart 2021;</li><li>Opgave fiets tot 2040;</li><li>Missing links fiets;</li><li>Van 50 naar 30 km</li></ul></ul></div><div align=\"center\" style=\"text-align: left;\"><br /></div><div align=\"center\" style=\"text-align: left;\">Wijzigingen 28 november 2023:</div><div align=\"center\" style=\"text-align: left;\"><ul><li>Nieuwe lagen MPR (Meerjaren Perspectief Ruimte) ingeladen</li></ul></div><div align=\"center\" style=\"text-align: left;\">Wijzigingen 8 november 2023:</div><div align=\"center\" style=\"text-align: left;\"><ul><li>Complete herziening MJIP-projecten;</li><li>Bijgewerkte kaartlagen:</li><ul><li>Bomen totaal areaal</li><li>OVL kabels areaal</li><li>VRI kabels areaal</li><li>Ondergrondse containers</li><li>Stedin - Gasvervanging bros</li></ul></ul></div><div align=\"center\" style=\"text-align: left;\"><br /></div><div align=\"center\" style=\"text-align: left;\">Wijzigingen 31 oktober 2023:</div><div align=\"center\" style=\"text-align: left;\"><ul><li>Kaartlagen 'Laadpalen huidig' en 'Laadpalen toekomstig' vervangen door nieuwe laag 'Laadpalen Gemeente Utrecht'</li></ul></div><div align=\"center\" style=\"text-align: left;\"><br /></div><div align=\"center\" style=\"text-align: left;\">Wijzigingen 18 september 2023:</div><div align=\"center\" style=\"text-align: left;\"><ul><li>Kaartlaag toegevoegd: Grondwaterbeschermingszones (onder overige referentielagen)</li></ul></div>"}},"index":10,"id":"widgets_About_Widget_37"}],"groups":[]},"mobileLayout":{"widgetOnScreen":{"widgets":[{"uri":"themes/PlateauTheme/widgets/HeaderController/Widget","position":{"left":0,"top":0,"right":0,"height":40,"relativeTo":"browser"},"version":"2.25"},{"uri":"widgets/Scalebar/Widget","visible":true,"position":{"left":25,"bottom":25,"relativeTo":"map"},"version":"2.25"},{"uri":"widgets/Search/Widget","visible":false,"position":{"left":55,"top":5,"relativeTo":"map"},"version":"2.25"},{"uri":"widgets/Coordinate/Widget","visible":false,"position":{"left":200,"bottom":20,"relativeTo":"map"},"version":"2.25"},{"uri":"widgets/OverviewMap/Widget","visible":false,"position":{"right":0,"bottom":0,"zIndex":1},"version":"2.25"},{"uri":"widgets/HomeButton/Widget","visible":true,"inPanel":false,"position":{"left":7,"top":75,"relativeTo":"map"},"version":"2.25"},{"uri":"widgets/MyLocation/Widget","visible":true,"inPanel":false,"position":{"left":7,"top":110,"relativeTo":"map"},"version":"2.25"},{"uri":"widgets/AttributeTable/Widget","visible":false,"version":"2.25","position":{"relativeTo":"browser"}},{"uri":"widgets/Splash/Widget","visible":false,"position":{"relativeTo":"browser"},"version":"2.25"},{"uri":"widgets/ZoomSlider/Widget","visible":true,"positi