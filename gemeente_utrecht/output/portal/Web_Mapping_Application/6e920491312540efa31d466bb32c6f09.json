0,"relativeTo":"map"},"version":"2.32","id":"widgets_Coordinate_Widget_25","name":"Coordinate"},{"uri":"widgets/OverviewMap/Widget","visible":false,"position":{"right":0,"bottom":0,"zIndex":1,"relativeTo":"map"},"version":"2.32","id":"widgets_OverviewMap_Widget_26","name":"OverviewMap"},{"uri":"widgets/HomeButton/Widget","position":{"left":7,"top":75,"relativeTo":"map"},"version":"2.32","id":"widgets_HomeButton_Widget_27","name":"HomeButton"},{"uri":"widgets/MyLocation/Widget","position":{"left":7,"top":110,"relativeTo":"map"},"version":"2.32","id":"widgets_MyLocation_Widget_28","name":"MyLocation"},{"uri":"widgets/AttributeTable/Widget","visible":false,"version":"2.32","position":{"relativeTo":"browser"},"id":"widgets_AttributeTable_Widget_29","name":"AttributeTable"},{"uri":"widgets/Splash/Widget","position":{"relativeTo":"browser"},"version":"2.32","id":"widgets_Splash_Widget_30","name":"Splash","config":{"splash":{"splashContent":"<div> </div>\n\t<div align=\"center\"><p class=\"MsoNormal\" style=\"text-align: left;\"><span style=\"color: rgb(255, 255, 255);\"><span style=\"font-size: 12pt;\">Door\nonderstaand vakje aan te vinken ga je naar de\nreferentiewoningentool. </span><span style=\"font-size: 12pt;\"><o:p></o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"text-align: left;\"><span style=\"color: rgb(255, 255, 255);\"><span style=\"font-size: 12pt;\">Door\nhier je postcode en huisnummer in te voeren, wordt een match gemaakt met\neen of meerdere referentiewoningen in Utrecht. </span><span style=\"font-size: 12pt;\"><o:p></o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"text-align: left;\"><span style=\"font-size: 12pt; color: rgb(255, 255, 255);\"><o:p> </o:p></span></p>\n\n<p class=\"MsoNormal\" style=\"text-align: left;\"><span style=\"color: rgb(255, 255, 255);\"><span style=\"font-size: 12pt;\">Een\nreferentiewoning lijkt bouwkundig en wat isolatie en energieverbruik betreft op\njouw woning. Aan de hand van de referentiewoning kun je zien welke\nmaatregelen je zou kunnen nemen om jouw huis energiezuiniger te maken.</span><span style=\"font-size: 12pt;\"><o:p></o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"text-align: left;\"><span style=\"font-size: 12pt; color: rgb(255, 255, 255);\"><o:p> </o:p></span></p>\n\n<p class=\"MsoNormal\" style=\"text-align: left;\"><span style=\"color: rgb(255, 255, 255);\"><span style=\"font-size: 12pt;\">Hoewel de\ngetoonde informatie met de grootste zorg is samengesteld, kunnen er geen\nrechten aan ontleend worden. Het is goed om je plannen voor het verduurzamen\nvan je huis altijd te bespreken met een energieadviseur of een aannemer.</span><span style=\"font-size: 12pt;\"><o:p></o:p></span></span></p><br /></div>","requireConfirm":true,"confirm":{"text":"Ik ga akkoord met de bovenstaande gebruiksvoorwaarden en bepalingen","color":"#ffffff","transparency":0},"showOption":true,"confirmEverytime":true,"contentVertical":"top","size":{"mode":"percent","percent":"50%","wh":{"w":600,"h":264}},"background":{"mode":"color","image":null,"type":"fill","fileName":"Geen%20bestand%20gekozen","color":"#485566","transparency":0},"button":{"color":"#518dca","transparency":0,"text":"OK"}}}},{"uri":"widgets/ZoomSlider/Widget","position":{"top":5,"left":7,"relativeTo":"map"},"version":"2.32","id":"widgets_ZoomSlider_Widget_31","name":"ZoomSlider"},{"uri":"widgets/ExtentNavigate/Widget","visible":false,"position":{"top":149,"left":7,"relativeTo":"map"},"version":"2.32","id":"widgets_ExtentNavigate_Widget_32","name":"ExtentNavigate"}],"panel":{"uri":"jimu/OnScreenWidgetPanel","position":{"relativeTo":"map"}}},"map":{"3D":false,"2D":true,"position":{"left":0,"top":40,"right":0,"bottom":0},"itemId":"f043b335062a4bcd91c7a0ac07cfd23f","mapOptions":{"extent":{"xmin":126580.38437239829,"ymin":450729.593579047,"xmax":141312.4138364572,"ymax":461753.2156262911,"spatialReference":{"wkid":28992,"latestWkid":28992}}},"id":"map","portalUrl":"https://gu-geo.maps.arcgis.com","appProxy":{"m