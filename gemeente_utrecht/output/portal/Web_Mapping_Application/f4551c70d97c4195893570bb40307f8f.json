{"source":"e4af8e4f8e8247d0bf167e23b4a8f1bc","folderId":"6cde55a2fbf24e21af89f900a4d3ee40","values":{"fullAppSettings":true,"landingPage":null,"landingPageConfig":{"titleText":"","subtitleText":"","descriptionText":"","entryButtonText":"","alignment":"center","backgroundType":"color","textColor":"#FFFFFF","entryButtonColor":"#0079C1","backgroundColor":"#0079C1","iconImage":null,"iconImageScale":"m","backgroundImageSrc":null},"splashButtonText":"Enter","title":"Verdachte gebieden Ontplofbare Oorlogsresten","searchConfiguration":{"allPlaceholder":"Adres of plaats zoeken","sources":[{"_uid":"3db6ddf7b29","url":"https://geocoder.arcgisonline.nl/arcgis/rest/services/Geocoder_NL_RD/GeocodeServer","singleLineFieldName":"SingleLine","name":"Esri Nederland Geocoder","placeholder":"","maxResults":null,"maxSuggestions":null,"suggestionsEnabled":null,"minSuggestCharacters":null,"withinViewEnabled":false,"countryCode":null,"zoomScale":10000}],"activeSourceIndex":0},"basemapGalleryConfig":{"basemapIdsToFilter":[]},"webmap":"a4ed0e36083847a594e519495cbc17f7","type":"webmap","homePosition":{"position":"top-left","index":1},"mapZoomPosition":{"position":"top-left","index":3},"compassWidgetPosition":{"position":"top-left","index":2},"keyboardShortcutsPosition":{"position":"top-left","index":0},"measurePosition":{"position":"top-right","index":0},"searchPosition":{"position":"top-right","index":1},"locateWidgetPosition":{"position":"top-right","index":4},"splashButtonPosition":{"position":"top-right","index":3},"languageSwitcherPosition":{"position":"top-right","index":2},"scalebarPosition":{"position":"bottom-left","index":0},"basemapTogglePosition":{"position":"bottom-right","index":0},"fullScreenPosition":{"position":"bottom-right","index":1},"details":true,"detailsContent":"<p class=\"MsoNormal\">Deze kaartviewer toont de gebieden waar er een hogere verwachting is dat er nog explosieven uit de Tweede Wereldoorlog in de grond of het water zijn, die niet ontploft zijn. De bommenkaart is gemaakt zodat bij werkzaamheden in de grond of het water hier rekening mee gehouden wordt. Zoals bij het heien of baggeren.</p><p class=\"MsoNormal\">U kunt geen rechten ontlenen aan de gegevens in de kaart. De gemeente Utrecht doet haar best om de informatie op deze kaart kloppend en actueel te houden. Komt u iets tegen wat niet klopt of sterk verouderd is, dan vinden wij het fijn als u ons dat laat weten. Dat kan via ons <a href=\"https://loket.digitaal.utrecht.nl/nl/form/reactieformulier/startpagina\" target=\"_blank\">reactieformulier</a>, bel 14 030 of neem contact op met ontplofbareoorlogsresten@utrecht.nl.</p><p class=\"MsoNormal\">De data in deze kaart is beschikbaar via de <a href=\"https://data.utrecht.nl/dataset/risicogebieden-ontplofbare-oorlogsresten-1\" target=\"_blank\">Datacatalogus</a> van de Gemeente Utrecht.&nbsp;</p><p class=\"MsoNormal\"><a href=\"https://data.utrecht.nl/dataset/geoserver-utrechtopen-ontplofbare-oorlogsresten\">Ontplofbare Oorlogsresten | Datacatalogus van Utrecht</a></p><p class=\"MsoNormal\">Bij deze data hoort het <a href=\"https://gu-geo.maps.arcgis.com/sharing/rest/content/items/95a10f42ff1841c48d1cf0ecb19a0307/data\" target=\"_blank\">rapport</a> \"Gemeentebreed Onderzoek Conflictperiode Ontplofbare Oorlogsresten Gemeente Utrecht\" van Expload uit &nbsp;2024.</p>","theme":"light","customTheme":{"applySharedTheme":false,"applyPresetTheme":true,"font":"Arial","appFont":"Arial","logo":null,"logoLink":"","logoScale":"m","logoUrl":"","logoSource":"upload","preset":null,"themes":{"primary":{"type":"primary","background":"#FFFFFF","text":"#000000"},"secondary":{"type":"secondary","background":"#FFFFFF","text":"#000000"},"accent":{"type":"accent","background":"#2964A3","text":"#FFFFFF"}}},"datePublished":1744785931730,"activePanel":"details","layerListPanel":true,"selectedLayers":{"layers":[]},"basemapGallery":false,"layerListPanelText":"Zet kaartlagen aan/uit","visibilityIcon":"checkbox","layerListLegend":true,"exportToPDFPo