chten ontlenen aan de monumentgrenzen in deze kaart. De grenzen die getoond worden op de kaart zijn niet in alle gevallen up-to-date. &nbsp;Als de begrenzing van een monument volgens u niet klopt dan vinden wij het fijn als u ons dat laat weten. Dat kan via ons <a href=\"https://www.utrecht.nl/reactieformulier\" target=\"_blank\">reactieformulier</a> of bel 14 030.</p>","filterPanel":false,"basemapGallery":true,"enableFeatureSearchScale":false,"popupHover":false,"compassWidget":false,"locateWidget":true,"measure":true,"keyboardShortcuts":true,"disableScroll":false,"scalebarDualMode":false,"extentSelector":false,"enableHighlightColor":true,"enableHighlightHaloColor":true,"basemapToggle":false,"share":false,"customUrlParam":{"layers":[]},"panelSize":"m","theme":"light","customTheme":{"applySharedTheme":false,"applyPresetTheme":true,"font":"Arial","appFont":"Arial","logo":"https://gu-geo.maps.arcgis.com/sharing/rest/content/items/61f02ad093934b5aaf7ca78ced8e752e/resources/media/instantAppsConfigPanel_1712215812278_Utrecht_Logo.png","logoLink":"https://www.utrecht.nl/","logoScale":"m","preset":null,"themes":{"primary":{"type":"primary","background":"#FFFFFF","text":"#000000"},"secondary":{"type":"secondary","background":"#FFFFFF","text":"#000000"},"accent":{"type":"accent","background":"#2964A3","text":"#ffffff"}}},"uploads":["https://gu-geo.maps.arcgis.com/sharing/rest/content/items/61f02ad093934b5aaf7ca78ced8e752e/resources/media/instantAppsConfigPanel_1712215812278_Utrecht_Logo.png"],"compassWidgetPosition":{"position":"top-left","index":3},"locateWidgetPosition":{"position":"top-left","index":4},"keyboardShortcutsPosition":{"position":"top-left","index":2},"searchPosition":{"position":"top-right","index":0},"splashButtonPosition":{"position":"top-right","index":3},"filterConfig":{"mapId":"36a7a6c69aee4916904411af2c3a9b84","layerExpressions":[]},"datePublished":1764664176305,"expandFilters":true,"selectedLayers":{"layers":[{"id":"18f76297469-layer-16","fields":[],"fi