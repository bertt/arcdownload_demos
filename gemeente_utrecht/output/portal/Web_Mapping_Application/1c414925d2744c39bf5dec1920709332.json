:"map","portalUrl":"https://gu-geo.maps.arcgis.com","appProxy":{"mapItemId":"ddd3669bd5fe4b279ebe9feacd9cd7a7","proxyItems":[]},"mapRefreshInterval":{"useWebMapRefreshInterval":true}},"widgetPool":{"panel":{"uri":"themes/PlateauTheme/panels/FoldablePanel/Panel","position":{"top":5,"right":5,"bottom":5,"zIndex":5,"relativeTo":"map"}},"widgets":[{"name":"About","label":"Over deze kaart","version":"2.31","uri":"widgets/About/Widget","config":{"about":{"aboutContent":"<div><font size=\"3\">De gemeente Utrecht is verantwoordelijk voor de inzameling en transport van afvalwater. Om dit goed te kunnen doen investeert de gemeente Utrecht in de riolering. Op deze kaart kunt u zien waar de gemeente Utrecht tot en met 2035 de riolering gaat vervangen. In de meeste gevallen ligt op deze plekken nu een gemengd riool. Dit wordt zoveel mogelijk vervangen door een gescheiden riool. </font></div><div><font size=\"3\"><br /></font></div><div><b><i><font size=\"3\">Legenda</font></i></b></div><div><b><i><font size=\"3\"><br /></font></i></b></div><div><img alt=\"LegendaMeerjarenBaggerplanning2.jpg\" id=\"img_1724146103409\" src=\"data:image/jpeg;base64,\" /><b><i><font size=\"3\"><br /></font></i></b></div><div><b><i><font size=\"3\">Knoppen</font></i></b><br /></div><div><font size=\"3\"><img alt=\"AGOL_OverDezeKaart_Icon.jpg\" id=\"img_1622540872936\" src=\"data:image/jpeg;base64,\" /><br /></font></div><div><font size=\"3\">Onder deze knop is informatie over de kaart te vinden.</font></div><div><font size=\"3\"><br /></font></div><div><font size=\"3\"><img alt=\"AGOL_Kaartlagen_Icon.jpg\" id=\"img_1622540883139\" src=\"data:image/jpeg;base64,\" /><br /></font></div><div><font size=\"3\">Onder deze knop verschijnt een menu om kaartlagen aan en uit te zetten.</font></div><div><font size=\"3\"><br /></font></div><div><font size=\"3\"><img alt=\"AGOL_Layers_Icon.jpg\" id=\"img_1622540894497\" src=\"data:image/jpeg;base64,\" /><br /></font></div><div><font size=\"3\">Met deze knop kan de legenda van de kaartlagen in de kaart opgeroepen worden.</font></div><div><font size=\"3\"><br /></font></div><div><font size=\"3\"><br /></font></div><div><b><i><font size=\"3\">Proclaimer</font></i></b></div><div><font size=\"3\">De Gemeente Utrecht doet haar best om de informatie op deze kaart kloppend en actueel te houden. Komt u iets tegen wat niet klopt, dan vinden wij het fijn als u ons dat laat weten. Stuur dan een e-mail naar <a href=\"mailto:waterproof030@utrecht.nl\">waterproof030@utrecht.nl</a> of bel 14 030. Meer informatie en achtergronden over water &amp; riolering in Utrecht vindt u op </font><a href=\"https://omgevingsvisie.utrecht.nl/thematisch-beleid/water/\" target=\"_blank\"><font size=\"3\">Visie water &amp; riolering</font></a><font size=\"3\">.</font><br /></div>"}},"index":2,"id":"widgets_About_Widget_31","openAtStart":true},{"uri":"widgets/LayerList/Widget","version":"2.31","id":"widgets_LayerList_Widget_19","name":"LayerList","index":3},{"uri":"widgets/Legend/Widget","version":"2.31","id":"widgets_Legend_Widget_18","name":"Legend","index":4}],"groups":[]},"mobileLayout":{"widgetOnScreen":{"widgets":[{"uri":"themes/PlateauTheme/widgets/HeaderController/Widget","position":{"left":0,"top":0,"right":0,"height":40,"relativeTo":"browser"},"version":"2.18"},{"uri":"widgets/Scalebar/Widget","visible":true,"position":{"left":25,"bottom":25,"relativeTo":"map"},"version":"2.18"},{"uri":"widgets/Search/Widget","visible":false,"position":{"left":55,"top":5,"relativeTo":"map"},"version":"2.18"},{"uri":"widgets/Coordinate/Widget","visible":false,"position":{"left":200,"bottom":20,"relativeTo":"map"},"version":"2.18"},{"uri":"widgets/OverviewMap/Widget","visible":false,"position":{"right":0,"bottom":0,"zIndex":1},"version":"2.18"},{"uri":"widgets/HomeButton/Widget","visible":true,"inPanel":false,"position":{"left":7,"top":75,"relativeTo":"map"},"version":"2.18"},{"uri":"widgets/MyLocation/Widget","visible":true,"inPanel":false,"position":{"left":7,"top":