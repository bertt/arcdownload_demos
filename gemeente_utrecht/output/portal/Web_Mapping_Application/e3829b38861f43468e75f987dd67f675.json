ass=\"MsoNormal\" style=\"background-color:rgb(255, 255, 255); color:rgb(0, 0, 0); font-family:Verdana; font-size:14px; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; margin:1em 0px; text-align:start; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;\">&nbsp;</p><ul><li><span style=\"color:black;\"><font size=\"2\"><span style=\"background:white;\">Yvon van Megen</span></font></span></li><li><span style=\"color:black;\"><font size=\"2\"><span style=\"background:white;\">Otto Nikkessen</span></font></span></li><li><span style=\"color:black;\"><font size=\"2\"><span style=\"background:white;\">René Correljé (Careyn)</span></font></span></li><li><span style=\"color:black;\"><font size=\"2\"><span style=\"background:white;\">Cornbread Zecc Architecten (altijd naam vermelden bij gebruik foto)</span></font></span></li><li><span style=\"color:black;\"><font size=\"2\"><span style=\"background:white;\">Martin van der Linden (Stichting Jongerius)</span></font></span></li><li><span style=\"color:black;\"><font size=\"2\"><span style=\"background:white;\">Frank van Vredendaal (KiTov)</span></font></span></li><li><span style=\"color:black;\"><font size=\"2\"><span style=\"background:white;\">Geert Procee (ELG, altijd naam vermelden bij gebruik foto)</span></font></span></li><li><span style=\"color:black;\"><font size=\"2\"><span style=\"background:white;\">Hanna Geerdink (Oversticht, altijd naam vermelden bij gebruik foto)</span></font></span></li><li><span style=\"color:black;\"><font size=\"2\"><span style=\"background:white;\">Fotodienst HUA (altijd naam vermelden van fotodienst)</span></font></span></li><li><span style=\"color:black;\"><font size=\"2\"><span style=\"background:white;\">Afdeling Erfgoed</span></font></span></li></ul><div style=\"background-color:rgb(255, 255, 255); color:rgb(0, 0, 0); font-family:Verdana; font-size:14px; fo