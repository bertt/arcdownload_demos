Widget_23","name":"Coordinate"},{"uri":"widgets/OverviewMap/Widget","visible":false,"position":{"right":0,"bottom":0,"zIndex":1,"relativeTo":"map"},"version":"2.31","id":"widgets_OverviewMap_Widget_24","name":"OverviewMap"},{"uri":"widgets/HomeButton/Widget","position":{"left":7,"top":75,"relativeTo":"map"},"version":"2.31","id":"widgets_HomeButton_Widget_25","name":"HomeButton"},{"uri":"widgets/MyLocation/Widget","position":{"left":7,"top":110,"relativeTo":"map"},"version":"2.31","id":"widgets_MyLocation_Widget_26","name":"MyLocation"},{"uri":"widgets/AttributeTable/Widget","visible":false,"version":"2.31","position":{"relativeTo":"browser"},"id":"widgets_AttributeTable_Widget_27","name":"AttributeTable"},{"uri":"widgets/Splash/Widget","position":{"relativeTo":"browser"},"version":"2.31","id":"widgets_Splash_Widget_28","name":"Splash","config":{"splash":{"splashContent":"<div> </div>\n\t<div align=\"center\"><p class=\"MsoNormal\"><font size=\"3\" style=\"color: rgb(0, 0, 1);\">De areaalkaart inzameling en transport hemelwater is\nverhuisd naar <a href=\"https://gu-geo.maps.arcgis.com/apps/instant/sidebar/index.html?appid=507fe5b9ac0141f89c5adb194fd55520\">Areaalkaart\ninzameling en transport hemelwater</a>. Bekijk deze nieuwe kaart voor de meest\nrecente informatie.</font><o:p></o:p></p><br /></div>","requireConfirm":false,"confirm":{"text":"","color":"#ffffff","transparency":0},"showOption":false,"confirmEverytime":true,"contentVertical":"middle","size":{"mode":"wh","wh":{"w":600,"h":264}},"background":{"mode":"color","image":null,"type":"fill","fileName":"Geen%20bestand%20gekozen","color":"#ffffff","transparency":0},"button":{"color":"#518dca","transparency":0,"text":"OK"}}}},{"uri":"widgets/ZoomSlider/Widget","position":{"top":5,"left":7,"relativeTo":"map"},"version":"2.31","id":"widgets_ZoomSlider_Widget_29","name":"ZoomSlider"},{"uri":"widgets/ExtentNavigate/Widget","visible":false,"position":{"top":149,"left":7,"relativeTo":"map"},"version":"2.31","id":"widgets_ExtentNavigate_Widget_30","name":"ExtentNavigate"}],"panel":{"uri":"jimu/OnScreenWidgetPanel","position":{"relativeTo":"map"}}},"map":{"3D":false,"2D":true,"position":{"left":0,"top":40,"right":0,"bottom":0},"itemId":"202c5c2cd1904fe08ce6aa1f8eb4919e","mapOptions":{},"id":"map","portalUrl":"https://gu-geo.maps.arcgis.com","appProxy":{"mapItemId":"202c5c2cd1904fe08ce6aa1f8eb4919e","proxyItems":[]},"mapRefreshInterval":{"useWebMapRefreshInterval":true}},"widgetPool":{"panel":{"uri":"themes/PlateauTheme/panels/FoldablePanel/Panel","position":{"top":5,"right":5,"bottom":5,"zIndex":5,"relativeTo":"map"}},"widgets":[{"name":"About","version":"2.31","uri":"widgets/About/Widget","config":{"about":{"aboutContent":"<div><span style=\"box-sizing: border-box; font-family: 'Avenir Light', Verdana, Geneva, sans-serif;\"><p class=\"MsoNormal\" style=\"\"><span style=\"\"><font size=\"3\">De gemeente Utrecht is verantwoordelijk voor\nde inzameling en het verwerken van hemelwater. Om dit goed te kunnen doen heeft\nde gemeente Utrecht een uitgebreid stelsel van leidingen, wadi’s en gemalen. Op\ndeze kaart kunt u zien via welke onderdelen het hemelwater wordt ingezameld en\nverwerkt. In ongeveer de helft van de gemeente wordt het afvalwater samen met\nneerslag, via een gemengd riool, ingezameld en naar de rioolwaterzuiveringen\ngebracht. In de nieuwere wijken wordt het hemelwater gescheiden van het\nafvalwater afgevoerd naar het oppervlaktewater. De gemeente streeft ernaar om\nin 2050 90% van de neerslag vast te houden waar die valt door middel van wadi’s\nen infiltratieriolen.<o:p></o:p></font></span></p><p class=\"MsoNormal\" style=\"\"><span style=\"\"><font size=\"3\"><br /></font></span></p></span></div><font size=\"3\"><span style=\"box-sizing: border-box;\"><div style=\"\"><span style=\"box-sizing: border-box;\"><font face=\"Avenir Light, Verdana, Geneva, sans-serif\"><div style=\"\"><b><i>Knoppen</i></b></div><div style=\"\"><img alt=\"AGOL_OverDezeKaart_Icon.jpg\" id=\"img_1620109957460\" src=\"data:image/jpeg;base64,\" /><br /></div><div style=\"\">Onder deze knop is informatie over de kaart te vinden.</div><div style=\"\"><br /></div><div style=\"\"><img alt=\"AGOL_Kaartlagen_Icon.jpg\" id=\"img_1620109966212\" src=\"data:image/jpeg;base64,\" /><br /></div><div style=\"\">Onder deze knop verschijnt een menu om kaartlagen aan en uit te zetten.</div><div style=\"\"><br /></div><div style=\"\"><img alt=\"AGOL_Layers_Icon.jpg\" id=\"img_1620109973965\" src=\"data:image/jpeg;base64,\" /><br /></div><div style=\"\">Met deze knop kan de legenda van de kaartlagen in de kaart opgeroepen worden.</div><div style=\"\"><br /></div></font></span></div><div style=\"font-family: 'Avenir Light', Verdana, Geneva, sans-serif;\"><span style=\"box-sizing: border-box; font-family: 'Avenir Light', Verdana, Geneva, sans-serif;\"><b><i>Proclaimer</i></b></span></div><div style=\"\"><font size=\"3\" style=\"\"><font face=\"Avenir Light, Verdana, Geneva, sans-serif\">De Gemeente Utrecht doet haar best om de informatie op deze kaart kloppend en actueel te houden. Komt u iets tegen wat niet klopt, dan vinden wij het fijn als u ons dat laat weten. Stuur dan een e-mail naar </font><a href=\"mailto:waterproof030@utrecht.nl\" style=\"font-family: &quot;Avenir Light&quot;, Verdana, Geneva, sans-serif;\">waterproof030@utrecht.nl</a><font face=\"Avenir Light, Verdana, Geneva, sans-serif\"> of bel 14 030. Meer informatie en achtergronden over water &amp; riolering in Utrecht vindt u op </font></font><a href=\"https://omgevingsvisie.utrecht.nl/thematisch-beleid/water/\" style=\"font-family: &quot;Avenir Light&quot;, Verdana, Geneva, sans-serif;\" target=\"_blank\">Visie water &amp; riolering</a><font size=\"3\" style=\"font-family: &quot;Avenir Light&quot;, Verdana, Geneva, sans-serif;\">.</font><br /></div></span></font>"}},"index":2,"id":"widgets_About_Widget_31","openAtStart":true,"label":"Over deze kaart"},{"uri":"widgets/LayerList/Widget","version":"2.31","id":"widgets_LayerList_Widget_19","name":"LayerList","index":3},{"uri":"widgets/Legend/Widget","version":"2.31","id":"widgets_Legend_Widget_18","name":"Legend","index":4}],"groups":[]},"mobileLayout":{"widgetOnScreen":{"widgets":[{"uri":"themes/PlateauTheme/widgets/HeaderController/Widget","position":{"left":0,"top":0,"right":0,"height":40,"relativeTo":"browser"},"version":"2.18"},{"uri":"widgets/Scalebar/Widget","visible":true,"position":{"left":25,"bottom":25,"relativeTo":"map"},"version":"2.18"},{"uri":"widgets/Search/Widget","visible":false,"position":{"left":55,"top":5,"relativeTo":"map"},"version":"2.18"},{"uri":"widgets/Coordinate/Widget","visible":false,"position":{"left":200,"bottom":20,"relativeTo":"map"},"version":"2.18"},{"uri":"widgets/OverviewMap/Widget","visible":false,"position":{"right":0,"bottom":0,"zIndex":1},"version":"2.18"},{"uri":"widgets/HomeButton/Widget","visible":true,"inPanel":false,"position":{"left":7,"top":75,"relativeTo":"map"},"version":"2.18"},{"uri":"widgets/MyLocation/Widget","visible":true,"inPanel":false,"position":{"left":7,"top":110,"relativeTo":"map"},"version":"2.18"},{"uri":"widgets/AttributeTable/Widget","visible":false,"version":"2.18","position":{"relativeTo":"browser"}},{"uri":"widgets/Splash/Widget","visible":false,"position":{"relativeTo":"browser"},"version":"2.18"},{"uri":"widgets/ZoomSlider/Widget","visible":true,"position":{"top":5,"left":7,"relativeTo":"map"},"version":"2.18"},{"uri":"widgets/ExtentNavigate/Widget","visible":false,"position":{"top":149,"left":7},"version":2.3}]},"map":{"position":{"left":0,"top":40,"right":0,"bottom":0}},"widgetPool":{"panel":{"uri":"themes/PlateauTheme/panels/FoldablePanel/Panel","position":{"top":5,"right":5,"bottom":5,"zIndex":5}}}},"loadingPage":{"backgroundColor":"#508dca","backgroundImage":{"visible":false},"loadingGif":{"visible":true,"uri":"configs/loading/images/predefined_loading_1.gif","width":58,"height":29}},"wabVersion":"2.31","_buildInfo":{"widgetManifestsMerged":true},"