dget_30","name":"ExtentNavigate"}],"panel":{"uri":"jimu/OnScreenWidgetPanel","position":{"relativeTo":"map"}}},"map":{"3D":false,"2D":true,"position":{"left":0,"top":40,"right":0,"bottom":0},"itemId":"62cb02872d7942d9b30a0bbf19b3decf","mapOptions":{"extent":{"xmin":125156.720666206,"ymin":449660.1113327184,"xmax":142593.85554047578,"ymax":462055.336123168,"spatialReference":{"wkid":28992,"latestWkid":28992}}},"id":"map","portalUrl":"https://gu-geo.maps.arcgis.com","appProxy":{"mapItemId":"62cb02872d7942d9b30a0bbf19b3decf","proxyItems":[]}},"widgetPool":{"panel":{"uri":"themes/PlateauTheme/panels/FoldablePanel/Panel","position":{"top":5,"right":5,"bottom":5,"zIndex":5,"relativeTo":"map"}},"widgets":[{"name":"About","label":"Over deze kaart","version":"2.32","uri":"widgets/About/Widget","config":{"about":{"aboutContent":"<div><p class=\"MsoNormal\"><font size=\"3\">We\nwillen dat alle inwoners van Utrecht voldoende verkoeling kunnen vinden op\nwarme dagen. Bijvoorbeeld door te zorgen voor koele verblijfsplekken. We willen\ndat Utrechters op maximaal 200 meter van hun woning een koele plek kunnen\nvinden, zoals een veldje met bomen of een park. Een koele plek bestaat voor\ntenminste 200m² uit schaduw en heeft bij voorkeur zitgelegenheid zoals een\nbankje. De plek is voldoende breed en de schaduw komt van minstens één boom.\nOok ligt de plek op minstens 5 meter afstand van wegen waar 50 km/u of harder\ngereden mag worden. Op deze kaart ziet u op welke afstand van uw woning een\nkoele plek te vinden is.</font><font face=\"Arial, sans-serif\" style=\"font-size: 10pt;\"><o:p></o:p></font></p></div><div><font size=\"3\"><br /></font></div><div><b><i><font size=\"3\">Legenda</font></i></b></div><div><img alt=\"Legenda_koele_verblijfsplekken.png\" id=\"img_1733424697939\" src=\"data:image/png;base64,\" /><b><i><font size=\"3\"><br /></font></i></b></div><div><br /></div><div><b><i><font size=\"3\"><br /></font></i></b></div><div><div><b><i><font size=\"3\">Knoppen</font></i><