x-sizing: border-box; margin: 0px; padding: 0px; font-family: 'Avenir Light', Verdana, Geneva, sans-serif; font-size: 12px;\"><b style=\"box-sizing: border-box;\"><i style=\"box-sizing: border-box;\"><font size=\"3\" style=\"box-sizing: border-box;\">Knoppen</font></i></b><br /></div><div style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-family: 'Avenir Light', Verdana, Geneva, sans-serif; font-size: 12px;\"><font size=\"3\" style=\"box-sizing: border-box;\"><img alt=\"AGOL_OverDezeKaart_Icon.jpg\" id=\"img_1622540872936\" src=\"data:image/jpeg;base64,\" style=\"box-sizing: border-box; border: 0px none;\" /><br /></font></div><div style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-family: 'Avenir Light', Verdana, Geneva, sans-serif; font-size: 12px;\"><font size=\"3\" style=\"box-sizing: border-box;\">Onder deze knop is informatie over de kaart te vinden.</font></div><div style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-family: 'Avenir Light', Verdana, Geneva, sans-serif; font-size: 12px;\"><font size=\"3\" style=\"box-sizing: border-box;\"><br /></font></div><div style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-family: 'Avenir Light', Verdana, Geneva, sans-serif; font-size: 12px;\"><br /></div><div style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-family: 'Avenir Light', Verdana, Geneva, sans-serif; font-size: 12px;\"><font size=\"3\" style=\"box-sizing: border-box;\"><img alt=\"AGOL_Layers_Icon.jpg\" id=\"img_1622540894497\" src=\"data:image/jpeg;base64,\" style=\"box-sizing: border-box; border: 0px none;\" /><br /></font></div><div style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-family: 'Avenir Light', Verdana, Geneva, sans-serif; font-size: 12px;\"><font size=\"3\" style=\"box-sizing: border-box;\">Met deze knop kan de legenda van de kaartlagen in de kaart opgeroepen worden.</font></div></div><div><font size=\"3\" style=\"box-sizing: border-box;\"><br /></font></div><div><br /></div><div>De gemeente Utrecht doet haar best om de informatie op deze kaart kloppend en actueel te houden. Komt u iets tegen wat niet klopt of sterk verouderd is, dan vinden wij het fijn als u ons dat laat weten. Dat kan via ons <a href=\"https://www.utrecht.nl/reactieformulier\" target=\"_self\">reactieformulier</a> of bel 14 030.<br /></div>"}},"index":3,"id":"widgets_About_Widget_31","openAtStart":true}],"groups":[]},"mobileLayout":{"widgetOnScreen":{"widgets":[{"uri":"themes/PlateauTheme/widgets/HeaderController/Widget","position":{"left":0,"top":0,"right":0,"height":40,"relativeTo":"browser"},"version":"2.27"},{"uri":"widgets/Scalebar/Widget","visible":true,"position":{"left":25,"bottom":25,"relativeTo":"map"},"version":"2.27"},{"uri":"widgets/Search/Widget","visible":false,"position":{"left":55,"top":5,"relativeTo":"map"},"version":"2.27"},{"uri":"widgets/Coordinate/Widget","visible":false,"position":{"left":200,"bottom":20,"relativeTo":"map"},"version":"2.27"},{"uri":"widgets/OverviewMap/Widget","visible":false,"position":{"right":0,"bottom":0,"zIndex":1},"version":"2.27"},{"uri":"widgets/HomeButton/Widget","visible":true,"inPanel":false,"position":{"left":7,"top":75,"relativeTo":"map"},"version":"2.27"},{"uri":"widgets/MyLocation/Widget","visible":true,"inPanel":false,"position":{"left":7,"top":110,"relativeTo":"map"},"version":"2.27"},{"uri":"widgets/AttributeTable/Widget","visible":false,"version":"2.27","position":{"relativeTo":"browser"}},{"uri":"widgets/Splash/Widget","visible":false,"position":{"relativeTo":"browser"},"version":"2.27"},{"uri":"widgets/ZoomSlider/Widget","visible":true,"position":{"top":5,"left":7,"relativeTo":"map"},"version":"2.27"},{"uri":"widgets/ExtentNavigate/Widget","visible":false,"position":{"top":149,"left":7},"version":2.3}]},"map":{"position":{"left":0,"top":40,"right":0,"bottom":0}},"widgetPool":{"panel":{"uri":"themes/PlateauTheme/panels/FoldablePanel/Panel","position":{"top":5,"right":5,"bottom":5,"zIndex":5}}}},"loadin