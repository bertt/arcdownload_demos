true}}}},{"name":"About","version":"2.31","uri":"widgets/About/Widget","index":4,"id":"widgets_About_Widget_33","config":{"about":{"aboutContent":"<div><span style=\"font-family: 'Times New Roman'; font-size: medium;\"><br /></span></div><div><span style=\"font-family: 'Times New Roman'; font-size: medium;\">Deze kaart betreft een concept, in ontwikkeling.</span><br /></div><div><span style=\"font-family: 'Times New Roman'; font-size: medium;\"><br /></span></div><div><font face=\"Times New Roman\" size=\"3\">Kaartlagen kunnen aan en uit worden gezet via de knop:</font></div><div><font face=\"Times New Roman\" size=\"3\"><br /></font></div><div><img alt=\"\" src=\"data:image/png;base64,\" /><font face=\"Times New Roman\" size=\"3\"><br /></font></div><div><font face=\"Times New Roman\" size=\"3\"><br /></font></div><div><font face=\"Times New Roman\" size=\"3\">De legenda van getoonde kaartlaag kan worden geraadpleegd via de knop:</font></div><div><br /></div><div><img alt=\"\" src=\"data:image/png;base64,\" /><br /></div><div><span style=\"font-family: 'Times New Roman'; font-size: medium;\"><br /></span></div><div><span style=\"font-family: 'Times New Roman'; font-size: medium;\"><br /></span></div><div><span style=\"font-family: 'Times New Roman'; font-size: medium;\">De gemeente Utrecht doet</span></div><p style=\"font-family: 'Times New Roman'; font-size: medium;\">haar best om de informatie op</p><p style=\"font-family: 'Times New Roman'; font-size: medium;\">deze kaart kloppend en</p><p style=\"font-family: 'Times New Roman'; font-size: medium;\">actueel te houden. Komt u iets</p><p style=\"font-family: 'Times New Roman'; font-size: medium;\">tegen wat niet klopt of sterk</p><p style=\"font-family: 'Times New Roman'; font-size: medium;\">verouderd is, dan vinden wij</p><p style=\"font-family: 'Times New Roman'; font-size: medium;\">het fijn als u ons dat laat</p><p style=\"font-family: 'Times New Roman'; font-size: medium;\">weten. Dat kan via ons</p><p style=\"font-family: 'Times New Roman'; font-size: medium;\"><a href=\"https://www.utrecht.nl/reactieformulier\" style=\"font-family: Verdana; font-size: 14px;\" target=\"_self\">reactieformulier</a> of bel 14 030</p>"}}}],"groups":[]},"mobileLayout":{"widgetOnScreen":{"widgets":[{"uri":"themes/PlateauTheme/widgets/HeaderController/Widget","position":{"left":0,"top":0,"right":0,"height":40,"relativeTo":"browser"},"version":"2.27"},{"uri":"widgets/Scalebar/Widget","visible":true,"position":{"left":25,"bottom":25,"relativeTo":"map"},"version":"2.27"},{"uri":"widgets/Search/Widget","visible":false,"position":{"left":55,"top":5,"relativeTo":"map"},"version":"2.27"},{"uri":"widgets/Coordinate/Widget","visible":false,"position":{"left":200,"bottom":20,"relativeTo":"map"},"version":"2.27"},{"uri":"widgets/OverviewMap/Widget","visible":false,"position":{"right":0,"bottom":0,"zIndex":1},"version":"2.27"},{"uri":"widgets/HomeButton/Widget","visible":true,"inPanel":false,"position":{"left":7,"top":75,"relativeTo":"map"},"version":"2.27"},{"uri":"widgets/MyLocation/Widget","visible":true,"inPanel":false,"position":{"left":7,"top":110,"relativeTo":"map"},"version":"2.27"},{"uri":"widgets/AttributeTable/Widget","visible":false,"version":"2.27","position":{"relativeTo":"browser"}},{"uri":"widgets/Splash/Widget","visible":false,"position":{"relativeTo":"browser"},"version":"2.27"},{"uri":"widgets/ZoomSlider/Widget","visible":true,"position":{"top":5,"left":7,"relativeTo":"map"},"version":"2.27"},{"uri":"widgets/ExtentNavigate/Widget","visible":false,"position":{"top":149,"left":7},"version":2.3}]},"map":{"position":{"left":0,"top":40,"right":0,"bottom":0}},"widgetPool":{"panel":{"uri":"themes/PlateauTheme/panels/FoldablePanel/Panel","position":{"top":5,"right":5,"bottom":5,"zIndex":5}}}},"loadingPage":{"backgroundColor":"#508dca","backgroundImage":{"visible":false},"loadingGif":{"visible":true,"uri":"configs/loading/images/predefined_loading_1.gif","width":58,"height":29}},"wabVersion":