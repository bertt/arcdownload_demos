{"source":"e4af8e4f8e8247d0bf167e23b4a8f1bc","folderId":"3fff72daa7684c6a8916061042b6d37f","values":{"fullAppSettings":true,"basemapGalleryConfig":{"basemapIdsToFilter":[]},"searchConfiguration":{"searchAllEnabled":true,"allPlaceholder":"Voorschool, adres of plaats zoeken","sources":[{"_uid":"9cfea73b596","displayField":"Locatie","exactMatch":false,"layer":{"url":"https://services-eu1.arcgis.com/SMnoOtmU2UWf0vRp/arcgis/rest/services/Voorscholen/FeatureServer","id":"Voorscholen_7785"},"maxResults":6,"maxSuggestions":6,"name":"Voorscholen","outFields":["Adres","Locatie"],"searchFields":["Adres","Locatie"],"placeholder":"Voorscholen","suggestionsEnabled":true,"minSuggestCharacters":1,"withinViewEnabled":false,"zoomScale":null,"popupTemplate":{"popupElements":[{"type":"fields","description":"","fieldInfos":[{"fieldName":"Aanbieder","isEditable":true,"label":"Aanbieder","visible":true},{"fieldName":"Locatie","isEditable":true,"label":"Locatie","visible":true},{"fieldName":"Adres","isEditable":true,"label":"Adres","visible":true},{"fieldName":"Postcode","isEditable":true,"label":"Postcode","tooltip":"","visible":true},{"fieldName":"Wijk","isEditable":true,"label":"Wijk","tooltip":"","visible":true},{"fieldName":"Website","isEditable":true,"label":"Website","visible":true}],"title":""}],"fieldInfos":[{"fieldName":"OBJECTID","isEditable":false,"label":"OBJECTID","tooltip":"","visible":false},{"fieldName":"Aanbieder","isEditable":true,"label":"Aanbieder","visible":true},{"fieldName":"Locatie","isEditable":true,"label":"Locatie","visible":true},{"fieldName":"Adres","isEditable":true,"label":"Adres","visible":true},{"fieldName":"Straat","isEditable":true,"label":"Straat","tooltip":"","visible":false},{"fieldName":"Huisnummer","isEditable":true,"label":"Huisnummer","visible":false},{"fieldName":"Huisletter","isEditable":true,"label":"Huisletter","visible":false},{"fieldName":"Toevoeging","isEditable":true,"label":"Toevoeging","visible":false},{"fieldName":"Postcode","isEditable