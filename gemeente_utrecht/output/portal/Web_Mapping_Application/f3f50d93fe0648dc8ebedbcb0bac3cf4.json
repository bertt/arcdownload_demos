{"theme":{"name":"PlateauTheme","styles":["orange","black","default","medium-grey","dark-blue","esri-blue","dark-green","esri-green"],"version":"2.17","sharedTheme":{"useHeader":false,"useLogo":false,"isPortalSupport":true},"customStyles":{"mainBackgroundColor":"#cc0000"}},"portalUrl":"https://gu-geo.maps.arcgis.com","appId":"","authorizedCrossOriginDomains":["geodata.utrecht.nl"],"title":"Erfgoed buitenplaatsen","subtitle":"","keepAppState":true,"logo":"https://gu-geo.maps.arcgis.com/sharing/rest/content/items/${itemId}/resources/inConfig/5931858257982816.png","geometryService":"https://utility.arcgisonline.com/arcgis/rest/services/Geometry/GeometryServer","links":[],"widgetOnScreen":{"widgets":[{"uri":"themes/PlateauTheme/widgets/HeaderController/Widget","position":{"left":0,"top":0,"right":0,"height":40,"relativeTo":"browser"},"version":"2.32","id":"themes_PlateauTheme_widgets_HeaderController_Widget_20","name":"HeaderController"},{"uri":"widgets/Scalebar/Widget","position":{"left":25,"bottom":25,"relativeTo":"map"},"version":"2.32","id":"widgets_Scalebar_Widget_21","name":"Scalebar"},{"uri":"widgets/Search/Widget","position":{"left":55,"top":5,"relativeTo":"map"},"version":"2.32","id":"widgets_Search_Widget_22","name":"Search","config":{"allPlaceholder":"","showInfoWindowOnSelect":true,"sources":[{"url":"https://services.arcgisonline.nl/arcgis/rest/services/Geocoder_BAG_RD/GeocodeServer","name":"Adressen (BAG)","singleLineFieldName":"SingleLine","placeholder":"Adres of plaats zoeken","countryCode":"","panToScale":false,"zoomScale":null,"maxSuggestions":6,"maxResults":6,"searchInCurrentMapExtent":false,"enableLocalSearch":false,"localSearchMinScale":300000,"localSearchDistance":50000,"radiusUnit":"meter","type":"locator"}]}},{"uri":"widgets/Coordinate/Widget","visible":false,"position":{"left":200,"bottom":20,"relativeTo":"map"},"version":"2.32","id":"widgets_Coordinate_Widget_23","name":"Coordinate"},{"uri":"widgets/OverviewMap/Widget","visible":false,"position":{"right":0,"bottom":0,"zIndex":1,"relativeTo":"map"},"version":"2.32","id":"widgets_OverviewMap_Widget_24","name":"OverviewMap"},{"uri":"widgets/HomeButton/Widget","position":{"left":7,"top":75,"relativeTo":"map"},"version":"2.32","id":"widgets_HomeButton_Widget_25","name":"HomeButton"},{"uri":"widgets/MyLocation/Widget","position":{"left":7,"top":110,"relativeTo":"map"},"version":"2.32","id":"widgets_MyLocation_Widget_26","name":"MyLocation"},{"uri":"widgets/AttributeTable/Widget","visible":false,"version":"2.32","position":{"relativeTo":"browser"},"id":"widgets_AttributeTable_Widget_27","name":"AttributeTable"},{"uri":"widgets/Splash/Widget","visible":false,"position":{"relativeTo":"browser"},"version":"2.32","id":"widgets_Splash_Widget_28","name":"Splash"},{"uri":"widgets/ZoomSlider/Widget","position":{"top":5,"left":7,"relativeTo":"map"},"version":"2.32","id":"widgets_ZoomSlider_Widget_29","name":"ZoomSlider"},{"uri":"widgets/ExtentNavigate/Widget","visible":false,"position":{"top":149,"left":7,"relativeTo":"map"},"version":"2.32","id":"widgets_ExtentNavigate_Widget_30","name":"ExtentNavigate"}],"panel":{"uri":"jimu/OnScreenWidgetPanel","position":{"relativeTo":"map"}}},"map":{"3D":false,"2D":true,"position":{"left":0,"top":40,"right":0,"bottom":0},"itemId":"7b0b1723adac4f98882df01bb0e29ca1","mapOptions":{},"id":"map","portalUrl":"https://gu-geo.maps.arcgis.com","appProxy":{"mapItemId":"7b0b1723adac4f98882df01bb0e29ca1","proxyItems":[]},"mapRefreshInterval":{"useWebMapRefreshInterval":true}},"widgetPool":{"panel":{"uri":"themes/PlateauTheme/panels/FoldablePanel/Panel","position":{"top":5,"right":5,"bottom":5,"zIndex":5,"relativeTo":"map"}},"widgets":[{"uri":"widgets/Legend/Widget","version":"2.32","id":"widgets_Legend_Widget_18","name":"Legend","index":2},{"uri":"widgets/LayerList/Widget","version":"2.32","id":"widgets_LayerList_Widget_19","name":"LayerList","index":3},{"name":"About","label":"Over deze kaart","version":"2.32","uri":"widgets/About/Widget","config":{"about":{"aboutContent":"<div style=\"text-align: left;\"><font size=\"3\">De Gemeente Utrecht doet haar best om de informatie op\ndeze kaart kloppend en actueel te houden. Komt u iets tegen wat niet klopt, dan\nvinden wij het fijn als u ons dat laat weten. Dat kan via ons <a href=\"https://www.utrecht.nl/reactieformulier\" target=\"_blank\">reactieformulier</a> of bel 14 030.</font></div><div style=\"text-align: left;\"><font size=\"3\"><br /></font></div><div style=\"text-align: left;\"><span style=\"font-weight: bold;\"><span style=\"font-style: italic;\"><font size=\"3\">Onder een buitenplaats verstaan we een samenhangend\ngeheel van hoofdgebouw, groenaanleg en bijgebouwen. Soms hoorden ook\nuitgebreide landbouwgronden tot de eigendommen. In de kaart zijn deze buiten\nbeschouwing gelaten.</font></span></span></div><div style=\"text-align: left;\"><span style=\"font-weight: bold;\"><span style=\"font-style: italic;\"><font size=\"3\"><br /></font></span></span></div><div style=\"text-align: left;\"><span style=\"font-weight: bold;\"><span style=\"font-style: italic;\"><font size=\"3\">De buitenplaatsenkaart bevat\ninformatie over voormalige buitenplaatsen in Utrecht. Sommige buitenplaatsen\nzijn volledig verdwenen, van andere zijn nog restanten van huis en/of tuin\naanwezig. In een enkel geval is de buitenplaats vrij intact bewaard gebleven of\nis de samenhang tussen huis en tuin hersteld.\n\n \n\n<br /></font></span></span></div><div style=\"text-align: left;\"><span style=\"font-weight: bold;\"><span style=\"font-style: italic;\"><font size=\"3\"><br /></font></span></span></div><div style=\"text-align: left;\"><font size=\"3\"><span style=\"font-weight: bold;\"><span style=\"font-style: italic;\">Niet alle buitenplaatsen zijn goed te lokaliseren. Soms\nis de precieze ligging onbekend of zijn de begrenzingen onzeker. Bovendien zijn\nbuitenplaatsen veranderlijk. Ze ontwikkelen zich in de loop van de tijd in\nfunctie, vorm en omvang. Kortom: het is niet altijd met zekerheid vast te\nstellen wat de grenzen van een buitenplaats waren. Bij aanklikken van een\nbuitenplaats op de kaart staat vermeld hoe (on)zeker de begrenzingen zijn.\n\n</span></span>  <br /></font></div><div style=\"text-align: left;\"><font size=\"3\"><br /></font></div><div style=\"text-align: left;\"><font size=\"3\">Buitenplaatsen komen in verschillende vormen voor. Het\nklassieke “buiten” is het zomerverblijf van een welgestelde familie. Er zijn\nook buitenplaatsen die ontstonden bij bedrijven of fabrieken – deze moesten dan\nvaak het succes van de onderneming uitdragen (bijv.: Huis Voorzorg, Rotsoord,\nZijdebalen). Utrecht had daarnaast een aantal luxe herbergen met bijbehorende theetuinen,\ndie later uitgroeiden tot buitenplaats (bijv.: De Oorsprong, Den Hommel,\nRhijnlust). Tot slot zijn er de succesvolle boerenbedrijven of hoveniers,\nwaarvan het woongebouw met omliggende tuin uitgroeide tot\nbuitenplaatsproporties (bijv.: Jaffa, Marksland, Minsweerd, de Minstroom).\n\n \n\n<span style=\"mso-spacerun:yes\"> </span> <br /></font></div><div style=\"text-align: left;\"><font size=\"3\"><br /></font></div><div style=\"text-align: left;\"><font size=\"3\">Veel buitenplaatsen liggen aan belangrijke waterwegen of\nverkeersaders van de stad, zoals de Vecht, de Krommerijn, de Leidsche Rijn, de\nVaartsche Rijn en de Biltstraat/Biltsestraatweg (bijv.: Oog in Al, Welgelegen,\nRoosendaal, Gildestein, Bloeiendaal, etc.). Deze plekken waren goed bereikbaar\n– een belangrijke voorwaarde voor een plek voor vrijetijdsbesteding, tijdelijke\nbewoning of het ontvangen van gasten, en eveneens belangrijk voor de aan- en\nafvoerlijnen van succesvolle bedrijven. Ook populair voor de aanleg van\nbuitenplaatsen waren voormalige kloosterterreinen (bijv.: Daelwijck, Oudwijk,\nHof ter Weyde, Chartreuse) en middeleeuwse hofstedes of heerlijkheden (bijv.:\nHuis te Voorn, Huis te Veen, Rhijnauwen, het Hogeland, Soestbergen). Daarnaast\nwaren de Maliebaan en de gebieden net buiten de stadswallen aantrekkelijke\nplekken voor buitenplaatsen (bijv.: Het Park, Nieuweroord, Raadwijk)</font></div>"}},"index":4,"id":"widgets_About_Widget_31"}],"groups":[]},"mobileLayout":{"widgetOnScreen":{"widgets":[{"uri":"themes/PlateauTheme/widgets/HeaderController/Widget","position":{"left":0,"top":0,"right":0,"height":40,"relativeTo":"browser"},"version":"2.17"},{"uri":"widgets/Scalebar/Widget","visible":true,"position":{"left":25,"bottom":25,"relativeTo":"map"},"version":"2.17"},{"uri":"widgets/Search/Widget","visible":false,"position":{"left":55,"top":5,"relativeTo":"map"},"version":"2.17"},{"uri":"widgets/Coordinate/Widget","visible":false,"position":{"left":200,"bottom":20,"relativeTo":"map"},"version":"2.17"},{"uri":"widgets/OverviewMap/Widget","visible":false,"position":{"right":0,"bottom":0,"zIndex":1},"version":"2.17"},{"uri":"widgets/HomeButton/Widget","visible":true,"inPanel":false,"position":{"left":7,"top":75,"relativeTo":"map"},"version":"2.17"},{"uri":"widgets/MyLocation/Widget","visible":true,"inPanel":false,"position":{"left":7,"top":110,"relativeTo":"map"},"version":"2.17"},{"uri":"widgets/AttributeTable/Widget","visible":false,"version":"2.17","position":{"relativeTo":"browser"}},{"uri":"widgets/Splash/Widget","visible":false,"position":{"relativeTo":"browser"},"version":"2.17"},{"uri":"widgets/ZoomSlider/Widget","visible":true,"position":{"top":5,"left":7,"relativeTo":"map"},"version":"2.17"},{"uri":"widgets/ExtentNavigate/Widget","visible":false,"position":{"top":149,"left":7},"version":2.3}]},"map":{"position":{"left":0,"top":40,"right":0,"bottom":0}},"widgetPool":{"panel":{"uri":"themes/PlateauTheme/panels/FoldablePanel/Panel","position":{"top":5,"right":5,"bottom":5,"zIndex":5}}}},"loadingPage":{"backgroundColor":"#508dca","backgroundImage":{"visible":false},"loadingGif":{"visible":true,"uri":"configs/loading/images/predefined_loading_1.gif","width":58,"height":29}},"wabVersion":"2.32","_buildInfo":{"widgetManifestsMerged":true},"isWeb