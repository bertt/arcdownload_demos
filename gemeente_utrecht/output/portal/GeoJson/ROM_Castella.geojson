{ "type": "Feature", "properties": { "id": null, "Naam": "Hoge Woerd", "Info": "Het eerste moderne archeologische onderzoek op de Hoge Woerd vond plaats in 1940. Daarbij werd de hoek van een stenen badgebouw blootgelegd. Het lag net ten noorden van het castellum, weten wij nu. In 2006 zijn de fundamenten van het badhuis in beeld gebracht door middel van grondradaronderzoek.", "Type": "Badhuis" }, "geometry": { "type": "MultiPolygon", "coordinates": [ [ [ [ 131306.422243392880773, 455534.997652282938361 ], [ 131309.35489820537623, 455543.049122891621664 ], [ 131313.001346440927591, 455541.697761492279824 ], [ 131314.367071947897784, 455544.968678831646685 ], [ 131324.018172490701545, 455541.449493053427432 ], [ 131324.871308436791878, 455543.688974948541727 ], [ 131339.765640395082301, 455538.730122270993888 ], [ 131333.580404789128806, 455521.916234406467993 ], [ 131308.875009293493349, 455530.909709161729552 ], [ 131309.888108229206409, 455533.611306366452482 ], [ 131306.422243392880773, 455534.997652282938361 ] ] ] ] } },
