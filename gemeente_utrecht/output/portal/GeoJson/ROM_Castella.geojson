{ "type": "Feature", "properties": { "id": null, "Naam": "Hoge Woerd", "Info": "Rondom de Hoge Woerd lag een krans van crematiegrafvelden voor de ca. 6.000 mensen die hier tussen ca. 40 en 270 moeten hebben geleefd. In 1999 en 2004 zijn er daarvan ongeveer 80 opgegraven. Vaak werd voedsel in potten meegegeven op de brandstapel. Op die manier weten we dat varkensvlees, kip, linzen en andere peulvruchten toen golden als een ‘zondagse maaltijd’. ", "Type": "Grafveld" }, "geometry": { "type": "MultiPolygon", "coordinates": [ [ [ [ 131232.752733486384386, 455029.456419874215499 ], [ 131238.075841127400054, 455031.230789117747918 ], [ 131243.69467697822256, 455031.723669486294966 ], [ 131253.157979476294713, 455030.146452453162055 ], [ 131258.67823927878635, 455026.992018318211194 ], [ 131259.466847829520702, 455025.119073042122182 ], [ 131259.565423917432781, 455021.274606404243968 ], [ 131257.002446176571539, 455018.120172232098412 ], [ 131253.157979548355797, 455016.542955130978953 ], [ 131247.144839425571263, 455016.345802963129245 ], [ 131241.328851434664102, 455016.838683269626927 ], [ 131233.048461744532688, 455019.007356711255852 ], [ 131230.682636106008431, 455022.063214795198292 ], [ 131230.584060016903095, 455026.104833564721048 ], [ 131232.752733486384386, 455029.456419874215499 ] ] ] ] } },
